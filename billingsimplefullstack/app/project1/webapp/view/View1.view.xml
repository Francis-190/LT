<mvc:View
    controllerName="project1.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:t="sap.ui.table">

    <Wizard id="myWizard" showNextButton="false" class="wizardContainer">

        <!-- Step 1: Dealer Information -->
        <WizardStep id="step1" title="Dealer Information">
            <VBox id="vb_Id" class="sapUiSmallMargin wizardStep">
                <f:SimpleForm id="SimpleFormToolbar"
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="4"
                    labelSpanL="3"
                    labelSpanM="4"
                    labelSpanS="12"
                    columnsXL="2"
                    columnsL="1"
                    columnsM="1"
                    singleContainerFullSize="false">

                    <f:content>
                        <Label text="Select Customer ID" labelFor="idDealerCombo" />
                        <ComboBox
                            id="idDealerCombo"
                            width="300px"
                            showClearIcon="true"
                            placeholder="Enter or choose an ID..."
                            items="{ path: '/Dealer' }"
                            class="comboBoxStyle">
                            <core:Item key="{dealerId}" text="{dealerId}" />
                        </ComboBox>

                        <Button text="Go" type="Emphasized" press=".onGoPress" width="20%" />

                        <Label text="Dealer Name" />
                        <Input value="{viewModel>/DealerName}" editable="false" width="300px" class="DealerName"/>

                        <Label text="Fund Availability" />
                        <Input value="{viewModel>/Stock_Availability}" editable="false" width="300px" class="fundavailable"/>

                        <Label text="Limit Available(in INF)" />
                        <Input value="{viewModel>/Limit_available}" editable="false" width="300px" class="limit"/>
                    </f:content>

                </f:SimpleForm>
            </VBox>
        </WizardStep>

        <!-- Step 2: Model Allocation -->
        <WizardStep id="step2" title="Model Allocation">
            <Panel class="tablePanel wizardStep">

                <t:Table
                    id="allocationTable"
                    rows="{viewModel>/Billings}"
                    selectionMode="None"
                    alternateRowColors="true"
                    width="auto"
                    enableColumnReordering="false"
                    columnHeaderVisible="true"
                    class="allocationTable">

                    <!-- Model Code -->
                    <t:Column width="150px">
                        <t:label><Label text="Model Code" class="boldHeader"/></t:label>
                        <t:template><Text text="{viewModel>modelCode}" /></t:template>
                    </t:Column>

                    <!-- Model Description -->
                    <t:Column width="25%">
                        <t:label><Label text="Model Description" class="boldHeader"/></t:label>
                        <t:template><Link text="{viewModel>modelDescription}" press=".onModelDescPress" class="modelLink"/></t:template>
                    </t:Column>

                    <!-- Stock Columns -->
                    <t:Column width="80px" hAlign="Center">
                        <t:multiLabels>
                            <Label text="Stock Availability" textAlign="Center" class="boldHeader"/>
                            <Label text="Stock" textAlign="Center" class="boldHeader"/>
                        </t:multiLabels>
                        <t:template><Text text="{viewModel>availability}" class="stockValue"/></t:template>
                    </t:Column>

                    <t:Column width="80px" hAlign="Center">
                        <t:multiLabels>
                            <Label text="Stock Availability" textAlign="Center" class="boldHeader"/>
                            <Label text="Available" textAlign="Center" class="boldHeader"/>
                        </t:multiLabels>
                        <t:template><Text text="{viewModel>stock}" class="stockValue"/></t:template>
                    </t:Column>

                    <!-- Total Quantity -->
                    <t:Column width="80px" hAlign="Center">
                        <t:label><Label text="Total Qty" class="boldHeader"/></t:label>
                        <t:template><Text text="{viewModel>totalQuantity}" class="totalQty"/></t:template>
                    </t:Column>

                    <!-- Fund Required -->
                    <t:Column width="120px" hAlign="End">
                        <t:label><Label text="Fund Required" class="boldHeader"/></t:label>
                        <t:template><Text text="{viewModel>fundRequired}" class="limit"/></t:template>
                    </t:Column>

                    <!-- Order Value -->
                    <t:Column width="120px" hAlign="End">
                        <t:label><Label text="Order Value" class="boldHeader"/></t:label>
                        <t:template><Text text="{viewModel>OrderVAlue}" class="fundavailable"/></t:template>
                    </t:Column>

                </t:Table>

                <!-- Total Information -->
                <f:SimpleForm
                    id="totalForm"
                    editable="false"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="2"
                    labelSpanL="2"
                    labelSpanM="4"
                    labelSpanS="6"
                    columnsXL="2"
                    columnsL="2"
                    columnsM="2"
                    singleContainerFullSize="false"
                    class="sapUiSmallMarginTop">

                    <f:content>
                        <Label text="Total Stock" design="Bold" />
                        <Text text="{viewModel>/TotalStock}" class="DealerName"/>

                        <Label text="Total Available" design="Bold" />
                        <Text text="{viewModel>/TotalAvailable}" class="DealerName"/>

                        <Label text="Total Qty" design="Bold" />
                        <Text text="{viewModel>/TotalQuantity}" class="totalQty"/>

                        <Label text="Fund Required" design="Bold" />
                        <Text text="{viewModel>/TotalFundRequired}" class="limit"/>

                        <Label text="Total Value" design="Bold" />
                        <Text text="{viewModel>/TotalOrderValue}" class="fundavailable"/>
                    </f:content>
                </f:SimpleForm>

            </Panel>
        </WizardStep>
    </Wizard>
</mvc:View>
